{
  "name": "bounded-systems-check-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm test",
    "format": "prettier --write \"*.mjs\" package.json",
    "format:check": "prettier --check \"*.mjs\" package.json",
    "lint": "eslint .",
    "test": "node --test validate.test.mjs",
    "validate": "node validate.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "cheerio": "1.1.2",
    "github-slugger": "2.0.0",
    "katex": "0.16.22",
    "markdown-it": "14.3.0",
    "markdownlint": "0.41.1",
    "mathjax": "4.1.3"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "prettier": "3.9.6"
  }
}
